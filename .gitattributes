# Normalise line endings: LF in the repository, native on checkout
* text=auto

# Files that must be LF even on Windows (they run on Linux)
*.sh    text eol=lf
*.bash  text eol=lf
Dockerfile text eol=lf
*.tf    text eol=lf

# Explicit text types
*.py    text
*.md    text
*.toml  text
*.yml   text
*.yaml  text
*.json  text
*.sql   text
*.tmdl  text

# Binary — never diff or line-ending-mangle these
*.pbix    binary
*.parquet binary
*.xlsx    binary
*.png     binary
*.jpg     binary
*.pdf     binary

# Keep GitHub's language stats honest
*.ipynb linguist-documentation
